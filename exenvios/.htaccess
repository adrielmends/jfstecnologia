# Priorizar o index.html sobre o index.php do WordPress
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Desativar MultiViews para evitar conflitos de extensao
    Options -MultiViews
    Options -Indexes

    # 2. Redirecionar ACESSO DIRETO a .php/.html para a URL limpa
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+)\.(php|html)\ [NC]
    RewriteRule ^ /%1 [L,R=301]

    # 3. REGRAS CRITICAS: Prioridade antes do WordPress
    RewriteRule ^admin/?$ admin.php [NC,L]
    RewriteRule ^admin-login/?$ admin-auth.php [L]
    RewriteRule ^painel/?$ painel.php [NC,L]
    RewriteRule ^login/?$ login.html [NC,L]
    RewriteRule ^logout/?$ logout.php [NC,L]

    # 4. Tratamento generico para outros arquivos .php (incluindo subpastas)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^.]+)/?$ $1.php [L]

    # 5. Tratamento generico para outros arquivos .html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^([^.]+)/?$ $1.html [L]

    # 6. Regras padrão do WordPress (Fallback)
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>
